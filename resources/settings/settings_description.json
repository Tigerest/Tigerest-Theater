  {
    "section": "mpv",
    "order": 5,
    "values": [
      {
        "value": "configMode",
        "display_name": "MPV 配置模式",
        "help": "Windows 与 macOS 默认都使用大河内置的稳定配置、脚本和 shader。只有主动选择自动或系统模式时才会读取当前用户的 mpv.conf；macOS 系统模式仍会隔离可能销毁播放器核心的用户脚本。切换后需要重启客户端。",
        "default": "embedded",
        "possible_values": [
          [ "embedded", "仅使用大河内置模式（推荐）" ],
          [ "auto", "自动：优先用户配置" ],
          [ "system", "仅使用系统 MPV 配置" ]
        ]
      },
      {
        "value": "renderBackend",
        "display_name": "视频渲染后端",
        "help": "Windows 使用嵌入主界面的 GPU-Next；macOS 使用独立的 GPU-Next/macvk 播放窗口，播放时隐藏 Emby，停止后自动恢复。libmpv Render API 仅作为兼容回退。切换后需要重启客户端。",
        "default": "auto",
        "possible_values": [
          [ "auto", "自动：GPU-Next（推荐）" ],
          [ "gpu-next", "原生 GPU-Next 嵌入", { "platforms_excluded": "osx" } ],
          [ "gpu-next", "独立 GPU-Next/macvk 窗口", { "platforms": "osx" } ],
          [ "libmpv", "libmpv Render API 兼容模式" ]
        ]
      },
      {
