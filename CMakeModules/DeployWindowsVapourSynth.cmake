# The VapourSynth runtime that ships with the Windows player (CPython's
# embeddable package and VapourSynth's portable wheel), pinned file by file by
# dev/windows/vapoursynth/runtime-lock.json. NVIDIA frame generation and other
# vapoursynth filters run on it when the RIFE extension is not installed.
# Configure and install share the check; install copies exact bytes and checks
# every copy.

function(tigerest_validate_vapoursynth runtime lock_file)
  if(NOT IS_DIRECTORY "${runtime}")
    message(FATAL_ERROR "TIGEREST_VAPOURSYNTH_RUNTIME_DIR is not a directory: ${runtime} (see dev/windows/vapoursynth/README.md)")
  endif()
  file(READ "${lock_file}" lock_text)
  string(JSON schema GET "${lock_text}" schemaVersion)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported VapourSynth runtime lock")
  endif()
  string(JSON count LENGTH "${lock_text}" files)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON relative MEMBER "${lock_text}" files ${index})
    string(JSON expected_hash GET "${lock_text}" files "${relative}" sha256)
    string(JSON expected_size GET "${lock_text}" files "${relative}" size)
    if(NOT EXISTS "${runtime}/${relative}" OR IS_SYMLINK "${runtime}/${relative}")
      message(FATAL_ERROR "Verified VapourSynth runtime file is missing: ${relative}")
    endif()
    file(SIZE "${runtime}/${relative}" actual_size)
    if(NOT actual_size EQUAL expected_size)
      message(FATAL_ERROR "Verified VapourSynth runtime size mismatch: ${relative}")
    endif()
    file(SHA256 "${runtime}/${relative}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Verified VapourSynth runtime checksum mismatch: ${relative}")
    endif()
  endforeach()
  # Nothing beyond the lock: a stray module would be importable by every script.
  file(GLOB_RECURSE present RELATIVE "${runtime}" "${runtime}/*")
  list(LENGTH present present_count)
  if(NOT present_count EQUAL count)
    message(FATAL_ERROR "The VapourSynth runtime has ${present_count} files, the lock ${count}: ${runtime}")
  endif()
endfunction()

function(tigerest_deploy_vapoursynth runtime lock_file install_dir)
  tigerest_validate_vapoursynth("${runtime}" "${lock_file}")
  file(READ "${lock_file}" lock_text)
  # An earlier runtime's files must not stay importable next to this one.
  file(REMOVE_RECURSE "${install_dir}/vapoursynth")
  set(sources)
  set(destinations)
  string(JSON count LENGTH "${lock_text}" files)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON relative MEMBER "${lock_text}" files ${index})
    list(APPEND sources "${runtime}/${relative}")
    list(APPEND destinations "${install_dir}/vapoursynth/${relative}")
  endforeach()
  foreach(name python vapoursynth)
    string(JSON relative GET "${lock_text}" licenses ${name})
    get_filename_component(file_name "${relative}" NAME)
    list(APPEND sources "${runtime}/${relative}")
    list(APPEND destinations "${install_dir}/licenses/vapoursynth/${name}-${file_name}")
  endforeach()
  list(APPEND sources "${lock_file}")
  list(APPEND destinations "${install_dir}/licenses/vapoursynth/runtime-lock.json")
  foreach(source destination IN ZIP_LISTS sources destinations)
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${source}" "${destination}"
                    RESULT_VARIABLE copy_result)
    if(NOT copy_result EQUAL 0)
      message(FATAL_ERROR "Failed to deploy the VapourSynth runtime: ${destination}")
    endif()
    file(SHA256 "${source}" source_hash)
    file(SHA256 "${destination}" deployed_hash)
    if(NOT deployed_hash STREQUAL source_hash)
      message(FATAL_ERROR "Deployed VapourSynth runtime checksum mismatch: ${destination}")
    endif()
  endforeach()
  # Detect a source replaced while copying.
  tigerest_validate_vapoursynth("${runtime}" "${lock_file}")
  message(STATUS "Deployed the verified VapourSynth runtime to vapoursynth")
endfunction()
