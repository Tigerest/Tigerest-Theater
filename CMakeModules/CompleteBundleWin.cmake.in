set(PROJECT_SOURCE_DIR @PROJECT_SOURCE_DIR@)
set(QTROOT "@QTROOT@")

message(STATUS "Running windeployqt from: ${QTROOT}/bin/windeployqt.exe")
message(STATUS "Target: ${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe")

execute_process(
  COMMAND "${QTROOT}/bin/windeployqt.exe" --verbose 9 --qmldir @SOURCE_ROOT@/src/ui "${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe"
  RESULT_VARIABLE WINDEPLOYQT_RESULT
)

if(NOT WINDEPLOYQT_RESULT EQUAL 0)
  message(FATAL_ERROR "windeployqt failed with exit code: ${WINDEPLOYQT_RESULT}")
endif()

# windeployqt may miss Qt6Xml.dll - copy explicitly
file(INSTALL "${QTROOT}/bin/Qt6Xml.dll" DESTINATION "${CMAKE_INSTALL_PREFIX}")

# Apply after windeployqt so it cannot restore the upstream compositor DLL.
set(TIGEREST_WEBENGINE_RUNTIME "@TIGEREST_WEBENGINE_RUNTIME@")
if(TIGEREST_WEBENGINE_RUNTIME)
  if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "Deploying patched WebEngine requires CMake 3.19 or newer")
  endif()
  if(NOT EXISTS "${TIGEREST_WEBENGINE_RUNTIME}/tigerest-webengine.json")
    message(FATAL_ERROR "Patched WebEngine build manifest is missing")
  endif()
  file(READ "${TIGEREST_WEBENGINE_RUNTIME}/tigerest-webengine.json" runtime_manifest)
  string(JSON runtime_version GET "${runtime_manifest}" qtVersion)
  string(JSON expected_patch_hash GET "${runtime_manifest}" patchSha256)
  string(JSON expected_core_hash GET "${runtime_manifest}" coreSha256)
  if(NOT runtime_version STREQUAL "@Qt6Core_VERSION@")
    message(FATAL_ERROR "WebEngine runtime ${runtime_version} does not match Qt @Qt6Core_VERSION@")
  endif()
  file(SHA256 "@PROJECT_SOURCE_DIR@/dev/windows/qtwebengine/qtwebengine-6.9.3-d3d11-producer-sync.patch" patch_hash)
  file(SHA256 "${TIGEREST_WEBENGINE_RUNTIME}/bin/Qt6WebEngineCore.dll" core_hash)
  string(TOLOWER "${expected_patch_hash}" expected_patch_hash)
  string(TOLOWER "${expected_core_hash}" expected_core_hash)
  if(NOT patch_hash STREQUAL expected_patch_hash OR NOT core_hash STREQUAL expected_core_hash)
    message(FATAL_ERROR "Patched WebEngine DLL or source patch does not match its build manifest")
  endif()
  foreach(name Qt6WebEngineCore.dll Qt6WebEngineQuick.dll
               Qt6WebEngineQuickDelegatesQml.dll QtWebEngineProcess.exe)
    if(NOT EXISTS "${TIGEREST_WEBENGINE_RUNTIME}/bin/${name}")
      message(FATAL_ERROR "Incomplete patched WebEngine runtime: ${name}")
    endif()
    file(INSTALL "${TIGEREST_WEBENGINE_RUNTIME}/bin/${name}"
         DESTINATION "${CMAKE_INSTALL_PREFIX}")
  endforeach()
  file(SHA256 "${CMAKE_INSTALL_PREFIX}/Qt6WebEngineCore.dll" deployed_core_hash)
  if(NOT deployed_core_hash STREQUAL expected_core_hash)
    message(FATAL_ERROR "Patched WebEngine DLL was not deployed correctly")
  endif()
  foreach(dir resources translations qml)
    if(NOT IS_DIRECTORY "${TIGEREST_WEBENGINE_RUNTIME}/${dir}")
      message(FATAL_ERROR "Incomplete patched WebEngine runtime: ${dir}")
    endif()
    file(COPY "${TIGEREST_WEBENGINE_RUNTIME}/${dir}/"
         DESTINATION "${CMAKE_INSTALL_PREFIX}/${dir}")
  endforeach()
  message(STATUS "Deployed patched WebEngine from ${TIGEREST_WEBENGINE_RUNTIME}")
  file(INSTALL "@PROJECT_SOURCE_DIR@/dev/windows/qtwebengine/README.md"
               "@PROJECT_SOURCE_DIR@/dev/windows/qtwebengine/qtwebengine-6.9.3-d3d11-producer-sync.patch"
               "${TIGEREST_WEBENGINE_RUNTIME}/tigerest-webengine.json"
       DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/qtwebengine-tigerest")
endif()

# on windows windeployqt doesnt install non qt libraries, let cmake do that
# include(BundleUtilities)

foreach(d @CMAKE_FIND_ROOT_PATH@)
  list(APPEND SEARCHDIRS ${d}/bin)
  list(APPEND SEARCHDIRS ${d}/lib)
endforeach()

get_filename_component(CEC_DIR @CEC_LIBRARY@ DIRECTORY)
list(APPEND SEARCHDIRS ${CEC_DIR})

# fixup_bundle("${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe" "" "${SEARCHDIRS}")
#install(PROGRAMS ${VCREDIST_DIR}/vcredist_msvc2017_x64.exe DESTINATION .)

# Install MPV DLL (MPV_LIBRARY points to .lib, we need the .dll)
get_filename_component(MPV_DIR "@MPV_LIBRARY@" DIRECTORY)
file(INSTALL "${MPV_DIR}/libmpv-2.dll" DESTINATION "${CMAKE_INSTALL_PREFIX}")

# Install fallback libmpv if present
get_filename_component(MPV_FALLBACK_DIR "${MPV_DIR}/../mpv-fallback" ABSOLUTE)
if(EXISTS "${MPV_FALLBACK_DIR}/libmpv-2.dll")
  file(INSTALL "${MPV_FALLBACK_DIR}/libmpv-2.dll" DESTINATION "${CMAKE_INSTALL_PREFIX}" RENAME "libmpv-fallback.dll")
  message(STATUS "Installed fallback libmpv")
endif()

if(@DO_ENABLE_ANGLE_DEP@)
  message(STATUS "Deploying separate ANGLE deps")
  file(INSTALL @DEPENDENCY_CACHE_DIR@/libEGL.dll @DEPENDENCY_CACHE_DIR@/libGLESv2.dll @DEPENDENCY_CACHE_DIR@/d3dcompiler_47.dll DESTINATION ${CMAKE_INSTALL_PREFIX})
else()
  message(STATUS "Not using separate ANGLE deps")
endif()

# Bundle MSVC runtime DLLs (pre-extracted by setup-windows.bat)
set(VCRUNTIME_DIR "@VCRUNTIME_DIR@")
set(VCREDIST_EXE "@VCREDIST_EXE@")

if(EXISTS "${VCRUNTIME_DIR}" AND EXISTS "${VCREDIST_EXE}")
  # Copy runtime DLLs to redist subfolder
  file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/redist")
  file(GLOB RUNTIME_DLLS "${VCRUNTIME_DIR}/*.dll")
  foreach(dll_path ${RUNTIME_DLLS})
    get_filename_component(dll_name "${dll_path}" NAME)
    file(INSTALL "${dll_path}" DESTINATION "${CMAKE_INSTALL_PREFIX}/redist")
    message(STATUS "Bundled runtime: ${dll_name}")
  endforeach()

  # Copy VCRedist installer for bundling
  file(INSTALL "${VCREDIST_EXE}" DESTINATION "${CMAKE_INSTALL_PREFIX}")
  message(STATUS "Bundled VCRedist installer: vc_redist.x64.exe")
else()
  message(WARNING "VCRuntime DLLs not found. Run setup-windows.bat first.")
endif()

if(@DO_SIGN@)
  file(GLOB_RECURSE EXES ${CMAKE_INSTALL_PREFIX}/*.exe ${CMAKE_INSTALL_PREFIX}/*.dll)
  set(ENV{errorlevel} 1)
  foreach(e ${EXES})
    message("-- Signing: ${PROJECT_SOURCE_DIR}/scripts/WindowsSign.cmd ${e}")
    execute_process(COMMAND ${PROJECT_SOURCE_DIR}/scripts/WindowsSign.cmd "${e}" RESULT_VARIABLE RES)
  endforeach()
endif()
