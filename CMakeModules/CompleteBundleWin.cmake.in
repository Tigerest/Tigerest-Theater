set(PROJECT_SOURCE_DIR @PROJECT_SOURCE_DIR@)
set(QTROOT "@QTROOT@")

# Recheck before windeployqt writes anything: the runtime can change after configure.
set(TIGEREST_WEBENGINE_RUNTIME "@TIGEREST_WEBENGINE_RUNTIME@")
include("@PROJECT_SOURCE_DIR@/CMakeModules/ValidateWindowsWebEngine.cmake")
tigerest_validate_webengine("${TIGEREST_WEBENGINE_RUNTIME}" "@Qt6Core_VERSION@" "@PROJECT_SOURCE_DIR@")
set(TIGEREST_OPENSSL_RUNTIME_DIR "@TIGEREST_OPENSSL_RUNTIME_DIR@")
set(TLS_LOCK_FILE "@PROJECT_SOURCE_DIR@/dev/windows/tls/runtime-lock.json")
include("@PROJECT_SOURCE_DIR@/CMakeModules/DeployWindowsOpenSSL.cmake")
tigerest_validate_openssl("${TIGEREST_OPENSSL_RUNTIME_DIR}" "${QTROOT}" "${TLS_LOCK_FILE}")

message(STATUS "Running windeployqt from: ${QTROOT}/bin/windeployqt.exe")
message(STATUS "Target: ${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe")

execute_process(
  COMMAND "${QTROOT}/bin/windeployqt.exe" --verbose 9 --force-openssl
          --qmldir "@SOURCE_ROOT@/src/ui"
          "${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe"
  RESULT_VARIABLE WINDEPLOYQT_RESULT
)

if(NOT WINDEPLOYQT_RESULT EQUAL 0)
  message(FATAL_ERROR "windeployqt failed with exit code: ${WINDEPLOYQT_RESULT}")
endif()

# --force-openssl deploys the Qt backend without looking for OpenSSL dependencies.
# Copy exact pinned bytes ourselves and retain the matching Qt plugin.
tigerest_deploy_openssl("${TIGEREST_OPENSSL_RUNTIME_DIR}" "${QTROOT}" "${TLS_LOCK_FILE}"
                        "${CMAKE_INSTALL_PREFIX}")
file(INSTALL "@PROJECT_SOURCE_DIR@/dev/windows/tls/NOTICE.txt"
     DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/openssl")

# windeployqt may miss Qt6Xml.dll - copy explicitly
file(INSTALL "${QTROOT}/bin/Qt6Xml.dll" DESTINATION "${CMAKE_INSTALL_PREFIX}")

# Apply after windeployqt so it cannot restore the upstream compositor DLL.
foreach(name Qt6WebEngineCore.dll Qt6WebEngineQuick.dll
             Qt6WebEngineQuickDelegatesQml.dll QtWebEngineProcess.exe)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${TIGEREST_WEBENGINE_RUNTIME}/bin/${name}"
                  "${CMAKE_INSTALL_PREFIX}/${name}" RESULT_VARIABLE runtime_copy_result)
  if(NOT runtime_copy_result EQUAL 0)
    message(FATAL_ERROR "Failed to deploy patched WebEngine: ${name}")
  endif()
endforeach()
file(SHA256 "${CMAKE_INSTALL_PREFIX}/Qt6WebEngineCore.dll" deployed_core_hash)
if(NOT deployed_core_hash STREQUAL TIGEREST_WEBENGINE_CORE_SHA256)
  message(FATAL_ERROR "Patched WebEngine DLL was not deployed correctly")
endif()
foreach(dir resources translations qml)
  file(COPY "${TIGEREST_WEBENGINE_RUNTIME}/${dir}/"
       DESTINATION "${CMAKE_INSTALL_PREFIX}/${dir}")
endforeach()
message(STATUS "Deployed patched WebEngine from ${TIGEREST_WEBENGINE_RUNTIME}")
file(INSTALL "@PROJECT_SOURCE_DIR@/dev/windows/qtwebengine/README.md"
             "@PROJECT_SOURCE_DIR@/dev/windows/qtwebengine/patches.txt"
             ${TIGEREST_WEBENGINE_PATCH_FILES}
             "${TIGEREST_WEBENGINE_RUNTIME}/tigerest-webengine.json"
     DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/qtwebengine-tigerest")

# on windows windeployqt doesnt install non qt libraries, let cmake do that
# include(BundleUtilities)

foreach(d @CMAKE_FIND_ROOT_PATH@)
  list(APPEND SEARCHDIRS ${d}/bin)
  list(APPEND SEARCHDIRS ${d}/lib)
endforeach()

get_filename_component(CEC_DIR @CEC_LIBRARY@ DIRECTORY)
list(APPEND SEARCHDIRS ${CEC_DIR})

# fixup_bundle("${CMAKE_INSTALL_PREFIX}/Tigerest Theater.exe" "" "${SEARCHDIRS}")
#install(PROGRAMS ${VCREDIST_DIR}/vcredist_msvc2017_x64.exe DESTINATION .)

# Link-time import libraries may come from the developer's existing setup;
# shipped kernels must match the release lock and include EOF-aware RIFE.
set(MPV_RUNTIME_DIR "@TIGEREST_MPV_RUNTIME_DIR@")
set(MPV_LOCK_FILE "@PROJECT_SOURCE_DIR@/dev/windows/rife/mpv-runtime-lock.json")
set(MPV_INSTALL_DIR "${CMAKE_INSTALL_PREFIX}")
include("@PROJECT_SOURCE_DIR@/CMakeModules/DeployWindowsMpv.cmake")

# NVIDIA frame generation's runtime, unmodified and hash-checked, when the
# build was configured with it.
set(TIGEREST_NVIDIA_VFX_RUNTIME_DIR "@TIGEREST_NVIDIA_VFX_RUNTIME_DIR@")
if(TIGEREST_NVIDIA_VFX_RUNTIME_DIR)
  include("@PROJECT_SOURCE_DIR@/CMakeModules/DeployWindowsNvidiaVfx.cmake")
  tigerest_deploy_nvidia_vfx("${TIGEREST_NVIDIA_VFX_RUNTIME_DIR}"
                             "@PROJECT_SOURCE_DIR@/dev/windows/nvidia-vfx/runtime-lock.json"
                             "@PROJECT_SOURCE_DIR@/dev/windows/nvidia-vfx/NOTICE.txt"
                             "${CMAKE_INSTALL_PREFIX}")
else()
  message(STATUS "Not deploying NVIDIA frame generation's runtime (TIGEREST_NVIDIA_VFX_RUNTIME_DIR is not set)")
endif()
# The VapourSynth runtime frame generation uses without the RIFE extension,
# unmodified and hash-checked, when the build was configured with it.
set(TIGEREST_VAPOURSYNTH_RUNTIME_DIR "@TIGEREST_VAPOURSYNTH_RUNTIME_DIR@")
if(TIGEREST_VAPOURSYNTH_RUNTIME_DIR)
  include("@PROJECT_SOURCE_DIR@/CMakeModules/DeployWindowsVapourSynth.cmake")
  tigerest_deploy_vapoursynth("${TIGEREST_VAPOURSYNTH_RUNTIME_DIR}"
                              "@PROJECT_SOURCE_DIR@/dev/windows/vapoursynth/runtime-lock.json"
                              "${CMAKE_INSTALL_PREFIX}")
else()
  message(STATUS "Not deploying the VapourSynth runtime (TIGEREST_VAPOURSYNTH_RUNTIME_DIR is not set)")
endif()
file(INSTALL "@PROJECT_SOURCE_DIR@/external/miniz/LICENSE"
             "@PROJECT_SOURCE_DIR@/external/miniz/README.tigerest.md"
     DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/miniz")

if(@DO_ENABLE_ANGLE_DEP@)
  message(STATUS "Deploying separate ANGLE deps")
  file(INSTALL @DEPENDENCY_CACHE_DIR@/libEGL.dll @DEPENDENCY_CACHE_DIR@/libGLESv2.dll @DEPENDENCY_CACHE_DIR@/d3dcompiler_47.dll DESTINATION ${CMAKE_INSTALL_PREFIX})
else()
  message(STATUS "Not using separate ANGLE deps")
endif()

# Bundle MSVC runtime DLLs (pre-extracted by setup-windows.bat)
set(VCRUNTIME_DIR "@VCRUNTIME_DIR@")
set(VCREDIST_EXE "@VCREDIST_EXE@")

if(EXISTS "${VCRUNTIME_DIR}" AND EXISTS "${VCREDIST_EXE}")
  # Copy runtime DLLs to redist subfolder
  file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/redist")
  file(GLOB RUNTIME_DLLS "${VCRUNTIME_DIR}/*.dll")
  foreach(dll_path ${RUNTIME_DLLS})
    get_filename_component(dll_name "${dll_path}" NAME)
    file(INSTALL "${dll_path}" DESTINATION "${CMAKE_INSTALL_PREFIX}/redist")
    message(STATUS "Bundled runtime: ${dll_name}")
  endforeach()

  # Copy VCRedist installer for bundling
  file(INSTALL "${VCREDIST_EXE}" DESTINATION "${CMAKE_INSTALL_PREFIX}")
  message(STATUS "Bundled VCRedist installer: vc_redist.x64.exe")
else()
  message(WARNING "VCRuntime DLLs not found. Run setup-windows.bat first.")
endif()

if(@DO_SIGN@)
  file(GLOB_RECURSE EXES ${CMAKE_INSTALL_PREFIX}/*.exe ${CMAKE_INSTALL_PREFIX}/*.dll)
  # NVIDIA's runtime ships unmodified and stays signed by NVIDIA; Python and
  # VapourSynth keep their own signatures and the hashes the lock pins.
  list(FILTER EXES EXCLUDE REGEX "/vfg/nvidia/")
  list(FILTER EXES EXCLUDE REGEX "/vapoursynth/")
  set(ENV{errorlevel} 1)
  foreach(e ${EXES})
    message("-- Signing: ${PROJECT_SOURCE_DIR}/scripts/WindowsSign.cmd ${e}")
    execute_process(COMMAND ${PROJECT_SOURCE_DIR}/scripts/WindowsSign.cmd "${e}" RESULT_VARIABLE RES)
  endforeach()
endif()
