# NVIDIA's Video Effects runtime for frame generation, pinned by
# dev/windows/nvidia-vfx/runtime-lock.json. Configure and install share the
# check; install copies exact bytes and checks every copy.

# Lists every locked file: its name, its path in the prepared runtime
# directory, its SHA-256 and its size.
function(tigerest_nvidia_vfx_files lock_text out_names out_paths out_hashes out_sizes)
  set(names)
  set(paths)
  set(hashes)
  set(sizes)
  foreach(group runtime licenses)
    string(JSON count LENGTH "${lock_text}" ${group})
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name MEMBER "${lock_text}" ${group} ${index})
      string(JSON hash GET "${lock_text}" ${group} "${name}" sha256)
      string(JSON size GET "${lock_text}" ${group} "${name}" size)
      list(APPEND names "${name}")
      if(group STREQUAL "licenses")
        list(APPEND paths "licenses/${name}")
      else()
        list(APPEND paths "${name}")
      endif()
      list(APPEND hashes "${hash}")
      list(APPEND sizes "${size}")
    endforeach()
  endforeach()
  set(${out_names} "${names}" PARENT_SCOPE)
  set(${out_paths} "${paths}" PARENT_SCOPE)
  set(${out_hashes} "${hashes}" PARENT_SCOPE)
  set(${out_sizes} "${sizes}" PARENT_SCOPE)
endfunction()

function(tigerest_validate_nvidia_vfx runtime lock_file)
  if(NOT IS_DIRECTORY "${runtime}")
    message(FATAL_ERROR "TIGEREST_NVIDIA_VFX_RUNTIME_DIR is not a directory: ${runtime} (see dev/windows/nvidia-vfx/README.md)")
  endif()
  file(READ "${lock_file}" lock_text)
  string(JSON schema GET "${lock_text}" schemaVersion)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported NVIDIA runtime lock")
  endif()
  tigerest_nvidia_vfx_files("${lock_text}" names paths hashes sizes)
  list(LENGTH paths count)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    list(GET paths ${index} relative)
    list(GET hashes ${index} expected_hash)
    list(GET sizes ${index} expected_size)
    if(NOT EXISTS "${runtime}/${relative}" OR IS_SYMLINK "${runtime}/${relative}")
      message(FATAL_ERROR "Verified NVIDIA runtime file is missing: ${relative}")
    endif()
    file(SIZE "${runtime}/${relative}" actual_size)
    if(NOT actual_size EQUAL expected_size)
      message(FATAL_ERROR "Verified NVIDIA runtime size mismatch: ${relative}")
    endif()
    file(SHA256 "${runtime}/${relative}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Verified NVIDIA runtime checksum mismatch: ${relative}")
    endif()
  endforeach()
endfunction()

function(tigerest_deploy_nvidia_vfx runtime lock_file notice install_dir)
  tigerest_validate_nvidia_vfx("${runtime}" "${lock_file}")
  file(READ "${lock_file}" lock_text)
  tigerest_nvidia_vfx_files("${lock_text}" names paths hashes sizes)
  set(sources)
  set(destinations)
  foreach(name relative IN ZIP_LISTS names paths)
    list(APPEND sources "${runtime}/${relative}")
    if(relative MATCHES "^licenses/")
      list(APPEND destinations "${install_dir}/licenses/nvidia-vfx/${name}")
    else()
      list(APPEND destinations "${install_dir}/vfg/nvidia/${name}")
    endif()
  endforeach()
  list(APPEND sources "${lock_file}" "${notice}")
  list(APPEND destinations "${install_dir}/licenses/nvidia-vfx/runtime-lock.json"
                           "${install_dir}/licenses/nvidia-vfx/NOTICE.txt")
  foreach(source destination IN ZIP_LISTS sources destinations)
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${source}" "${destination}"
                    RESULT_VARIABLE copy_result)
    if(NOT copy_result EQUAL 0)
      message(FATAL_ERROR "Failed to deploy the NVIDIA runtime: ${destination}")
    endif()
    file(SHA256 "${source}" source_hash)
    file(SHA256 "${destination}" deployed_hash)
    if(NOT deployed_hash STREQUAL source_hash)
      message(FATAL_ERROR "Deployed NVIDIA runtime checksum mismatch: ${destination}")
    endif()
  endforeach()
  # Detect a source replaced while copying.
  tigerest_validate_nvidia_vfx("${runtime}" "${lock_file}")
  message(STATUS "Deployed the verified NVIDIA Video Effects runtime to vfg/nvidia")
endfunction()
