+        target = align_flip_to_vsync(in, target, duration, &aligned);
 
     // "normal" strict drop threshold.
     in->dropped_frame = duration >= 0 && end_time < now;
@@ -1034,6 +1183,10 @@ static bool render_frame(struct vo *vo)
         mp_mutex_lock(&in->lock);
         in->dropped_frame = prev_drop_count < vo->in->drop_count;
         in->rendering = false;
+        in->last_vsync_time = vsync_grid_anchor(in, &vsync);
+        in->composed = vsync.composed;
+        score_composed_flips(vo, &vsync, aligned);
+        count_missing_grid(vo, &vsync);
 
         update_vsync_timing_after_swap(vo, &vsync);
     }
