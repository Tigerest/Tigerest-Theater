diff --git a/video/out/vo.c b/video/out/vo.c
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -149,6 +149,20 @@ struct vo_internal {
     int num_vsync_samples;
     int64_t num_total_vsync_samples;
     int64_t prev_vsync;
+    int64_t last_vsync_time;        // physical vsync reported by the VO, or 0
+    bool composed;                  // the VO reports DWM composition
+    struct {                        // see score_composed_flips()
+        bool place;                 // 0: half way between vsyncs, 1: before one
+        int64_t id[8], vsync[8];    // recent composed flips: present ID, vsync
+        bool place_of[8];
+        int counts[4], scored;      // shown -1, 0, 1, 2+ vsyncs after it
+        double share[2];            // last window per place, 0 if unknown
+        int age[2];                 // windows since share[] was measured
+    } flips;
+    struct {                        // see count_missing_grid()
+        int frames, no_vsync, no_match;
+        double refresh;             // last refresh period off the display's, ms
+    } grid;
     double base_vsync;
     int drop_point;
     double estimated_vsync_interval;
@@ -909,12 +923,144 @@ static void wait_until(struct vo *vo, int64_t target)
     while (target > mp_time_ns()) {
         if (in->queued_events & VO_EVENT_LIVE_RESIZING)
             break;
+#if HAVE_WIN32_THREADS
+        // Win32 condition waits take whole milliseconds, and a timed-out wait
+        // returns before target: breaking out there flipped audio-synced frames
+        // up to 1 ms early. Frame times close to a vsync then alternate between
+        // neighbouring vsyncs (3/5 refresh holds instead of 4/4 for 60 fps on
+        // 240 Hz). Sleep with a 1 ms margin, then poll the rest of the way.
+        mp_cond_timedwait(&in->wakeup, &in->lock,
+                          target - mp_time_ns() - MP_TIME_MS_TO_NS(1));
+#else
         if (mp_cond_timedwait_until(&in->wakeup, &in->lock, target))
             break;
+#endif
     }
     mp_mutex_unlock(&in->lock);
 }
 
+// Frames that are not display-synced are flipped at their pts, which has no
+// relation to the vsync grid. A flip close to a vsync catches it or misses it
+// depending on how long the present takes (mostly 0.5-2 ms, now and then
+// nearly a whole vsync), so a constant frame rate alternates between
+// neighbouring hold counts (3/5 vsyncs instead of 4/4 for 59.94 fps on 240 Hz).
+// Keep the first vsync at or after target, but flip just before the vsync
+// before it: too late for that vsync, the present gets a whole vsync to reach
+// the next one. DWM instead takes presents until a deadline before each vsync,
+// and flips close to it alternate between neighbouring vsyncs. The deadline
+// moves with DWM's timing (0.3-0.5 ms before a vsync, or anywhere from 1.3 to
+// 3 ms before it): when composed, flip half way between the two vsyncs or
+// just before the earlier one, whichever keeps the frames on their vsync (see
+// score_composed_flips()). *aligned is the vsync of a composed flip, or 0.
+// Called locked.
+static int64_t align_flip_to_vsync(struct vo_internal *in, int64_t target,
+                                   int64_t duration, int64_t *aligned)
+{
+    double interval = in->vsync_interval;
+    int64_t vsync = in->last_vsync_time;
+    *aligned = 0;
+    // Each frame must keep a vsync of its own, and the grid must be recent.
+    if (vsync <= 0 || interval <= 1 || duration < interval * 3 / 2 ||
+        in->paused || llabs(target - vsync) > MP_TIME_S_TO_NS(1))
+        return target;
+    double vsyncs = ceil((target - vsync) / interval);
+    if (in->composed) {
+        *aligned = vsync + (int64_t)(vsyncs * interval);
+        if (!in->flips.place)
+            return vsync + (int64_t)((vsyncs - 0.5) * interval);
+    }
+    return vsync + (int64_t)((vsyncs - 1) * interval) - MP_TIME_US_TO_NS(50);
+}
+
+// Composed flips: the VO reports the vsync each present was shown on. After a
+// window of 120, the place they were flipped at stays if at least 90% were
+// shown the same number of vsyncs after their aligned one. Otherwise it moves
+// to the other place, unless that one did worse when it was last measured
+// (forgotten after 16 windows). Both places show on the same vsync when the
+// deadline is far from both, so moving costs nothing there.
+// Called locked.
+static void score_composed_flips(struct vo *vo,
+                                 const struct vo_vsync_info *vsync,
+                                 int64_t aligned)
+{
+    struct vo_internal *in = vo->in;
+    if (vsync->submit_id <= 0)
+        return;
+    int n = vsync->submit_id & 7;
+    in->flips.id[n] = aligned ? vsync->submit_id : 0;
+    in->flips.vsync[n] = aligned;
+    in->flips.place_of[n] = in->flips.place;
+    n = vsync->shown_id & 7;
+    if (!vsync->shown_id || in->flips.id[n] != vsync->shown_id ||
+        in->flips.place_of[n] != in->flips.place)
+        return;
+    in->flips.id[n] = 0; // score each present once
+    double late = (vsync->shown_vsync - in->flips.vsync[n]) / in->vsync_interval;
+    in->flips.counts[MPCLAMP(lrint(late), -1, 2) + 1]++;
+    if (++in->flips.scored < 120)
+        return;
+    int kept = 0;
+    for (int i = 0; i < 4; i++)
+        kept = MPMAX(kept, in->flips.counts[i]);
+    double share = kept / (double)in->flips.scored;
+    bool place = in->flips.place;
+    in->flips.share[place] = share;
+    in->flips.age[place] = 0;
+    if (++in->flips.age[!place] > 16)
+        in->flips.share[!place] = 0;
+    if (share < 0.9 && (!in->flips.share[!place] ||
+                        in->flips.share[!place] > share))
+    {
+        MP_VERBOSE(vo, "%.0f%% of composed frames kept their vsync, flipping "
+                   "them %s.\n", share * 100,
+                   place ? "half way between vsyncs" : "before a vsync");
+        in->flips.place = !place;
+    }
+    in->flips.scored = 0;
+    memset(in->flips.counts, 0, sizeof(in->flips.counts));
+}
+
+// Composed frames are flipped at their pts while there is no vsync grid. Every
+// 600 composed frames, log how many had none and why if more than 1% did: no
+// vsync reported, or a measured refresh period off the display's. A few miss
+// it at the start and after each DXGI statistics disjoint.
+// Called locked.
+static void count_missing_grid(struct vo *vo, const struct vo_vsync_info *vsync)
+{
+    struct vo_internal *in = vo->in;
+    if (!vsync->composed)
+        return;
+    if (vsync->last_vsync_time <= 0) {
+        in->grid.no_vsync++;
+    } else if (!in->last_vsync_time) {
+        in->grid.no_match++;
+        in->grid.refresh = vsync->vsync_duration / 1e6;
+    }
+    if (++in->grid.frames < 600)
+        return;
+    int missing = in->grid.no_vsync + in->grid.no_match;
+    if (missing > in->grid.frames / 100) {
+        MP_VERBOSE(vo, "%d of %d composed frames had no vsync grid: %d without "
+                   "a vsync, %d with a refresh of %.3f ms (display %.3f ms).\n",
+                   missing, in->grid.frames, in->grid.no_vsync,
+                   in->grid.no_match, in->grid.refresh, in->vsync_interval / 1e6);
+    }
+    memset(&in->grid, 0, sizeof(in->grid));
+}
+
+// The physical vsync to align flips to, or 0. There is no vsync grid with VRR:
+// the display refreshes when a frame arrives, and the measured refresh period
+// follows the frame rate instead of the nominal interval.
+// Called locked.
+static int64_t vsync_grid_anchor(struct vo_internal *in,
+                                 const struct vo_vsync_info *vsync)
+{
+    double interval = in->vsync_interval;
+    if (fabs(vsync->vsync_duration - interval) >= interval / 20)
+        return 0;
+    return vsync->last_vsync_time;
+}
+
 static bool render_frame(struct vo *vo)
 {
     struct vo_internal *in = vo->in;
@@ -951,6 +1097,9 @@ static bool render_frame(struct vo *vo)
 
     // Time at which we should flip_page on the VO.
     int64_t target = frame->display_synced ? 0 : pts - in->flip_queue_offset;
+    int64_t aligned = 0;
