+// Constant buffers have their own register namespace, but only 14 slots, and
+// libplacebo numbers UBOs after every texture of the pass. A pass that binds
+// 14 or more textures would put its UBO at b14 or higher, which D3DCompile
+// rejects. Keep register == binding whenever that slot exists and is free, so
+// every pass that compiled before compiles to the same bytecode; otherwise take
+// the lowest free slot that no UBO of this stage (`ubos`) claims as its own
+// binding, which also keeps clear of SPIRV-Cross's register == binding
+// fallback. Returns -1 when every slot is taken.
+static int cbv_register(pl_gpu gpu, const struct d3d_pass_stage *pass_s,
+                        spvc_compiler sc_comp, unsigned int binding,
+                        const spvc_reflected_resource *ubos, size_t num_ubos)
+{
+    const int num_slots = D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT;
+    if (binding < (unsigned int) num_slots &&
+        ((int) binding >= pass_s->cbvs.num ||
+         pass_s->cbvs.elem[binding] == HLSL_BINDING_NOT_USED))
+        return binding;
+
+    for (int slot = 0; slot < num_slots; slot++) {
+        if (slot < pass_s->cbvs.num &&
+            pass_s->cbvs.elem[slot] != HLSL_BINDING_NOT_USED)
+            continue;
+
+        bool claimed = false;
+        for (size_t i = 0; i < num_ubos && !claimed; i++) {
+            claimed = spvc_compiler_get_decoration(sc_comp, ubos[i].id,
+                          SpvDecorationDescriptorSet) == 0 &&
+                      spvc_compiler_get_decoration(sc_comp, ubos[i].id,
+                          SpvDecorationBinding) == (unsigned int) slot;
+        }
+        if (!claimed) {
+            PL_DEBUG(gpu, "Binding %u uses constant buffer slot b%d",
+                     binding, slot);
+            return slot;
+        }
+    }
+
+    return -1;
+}
