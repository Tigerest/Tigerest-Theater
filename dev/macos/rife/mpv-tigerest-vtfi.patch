+# Tigerest: Apple-native frame interpolation with VideoToolbox's frame
+# processors (video/filter/vf_tigerest_vtfi.c). The client's build script
+# copies the filter and its engine into video/filter from the client sources.
+tigerest_vtfi = dependency('appleframeworks', modules: ['VideoToolbox', 'CoreMedia', 'Foundation'],
+                           required: false)
+features += {'tigerest-vtfi': features['videotoolbox-pl'] and tigerest_vtfi.found()}
+if features['tigerest-vtfi']
+    dependencies += tigerest_vtfi
+    sources += files('video/filter/vf_tigerest_vtfi.c', 'video/filter/TigerestVTInterpolator.m')
+endif
+
 
